# Token di accesso per l'app (uno o più, separati da virgola). Generane uno con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
QUADERNO_API_TOKENS=sostituisci-con-un-token-lungo-e-casuale

# Segreti dei provider: restano sul server, mai nell'app.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Archiviazione e politiche
QUADERNO_DATA_DIR=./data
QUADERNO_RETENTION_HOURS=24
QUADERNO_DELETE_AUDIO_AFTER_COMPLETION=1
QUADERNO_MAX_UPLOAD_MB=600
QUADERNO_MAX_CONCURRENT_JOBS=1
QUADERNO_MAX_ATTEMPTS=3

# Worker (sviluppo locale)
QUADERNO_WORKER_BIN=../Packages/QuadernoCore/.build/release/quaderno-worker
PROMPTS_DIR=../Packages/QuadernoCore/Sources/QuadernoCore/Resources/prompts
CHUNK_SECONDS=360
